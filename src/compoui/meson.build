lib_compoui = static_library(
  'compoui',
  [
    'glad/glad.c',
    'cui.cpp',
    'hitbox.cpp',
    'texture.cpp',
    'fbo.cpp',
    'util/shader.cpp',
    'font/font.cpp',
    'elements/primitive/primitive.cpp',
    'elements/primitive/shape.cpp',
    'elements/primitive/fill.cpp',
    'elements/primitive/image.cpp',
    'elements/primitive/text.cpp',
    'elements/primitive/border.cpp',
    'filter/filter.cpp',
    'filter/identity.cpp',
    'filter/opacity.cpp',
    'filter/blur.cpp',
    'shape/rectangle.cpp',
    'shape/roundedrect.cpp',
  ],
  dependencies: [
    dependency('gl'), 
    dependency('glu'),
    dependency('freetype2'),
  ],
  link_args: ['-lglad', '-ldl']
)